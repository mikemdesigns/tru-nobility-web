---
interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
  align?: "left" | "split";
}
const { eyebrow, title, intro, align = "left" } = Astro.props;
---

<header class:list={["section-heading", `section-heading--${align}`]}>
  <p class="eyebrow">{eyebrow}</p>
  <h2>{title}</h2>
  {intro && <p class="section-intro">{intro}</p>}
</header>
