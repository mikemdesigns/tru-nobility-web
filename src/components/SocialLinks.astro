---
import Icon from "./Icon.astro";

interface Social {
  label: string;
  key: string;
  href: string;
}

interface Props {
  socials: Social[];
  compact?: boolean;
}

const { socials, compact = false } = Astro.props;
---

<div class:list={["social-links", { "social-links--compact": compact }]} aria-label="Social media">
  {socials.map((social) => social.href ? (
    <a href={social.href} target="_blank" rel="noreferrer" aria-label={social.label}>
      <Icon name={social.key} />
    </a>
  ) : (
    <span class="social-link--pending" title={`Add the ${social.label} URL in src/content/site.json`} aria-label={`${social.label} link to add`}>
      <Icon name={social.key} />
    </span>
  ))}
</div>
