---
interface Social {
  label: string;
  key: string;
  href: string;
}

interface Props {
  socials: Social[];
  compact?: boolean;
}

const { socials, compact = false } = Astro.props;
---

<div class:list={["social-links", { "social-links--compact": compact }]} aria-label="Social media">
  {socials.map((social) => social.href ? (
    <a href={social.href} target="_blank" rel="noreferrer" aria-label={social.label}>
      {social.key === "instagram" && (
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1" class="fill"></circle></svg>
      )}
      {social.key === "youtube" && (
        <svg viewBox="0 0 24 24" aria-hidden="true"><path class="fill" d="M21.6 7.2a2.9 2.9 0 0 0-2-2C17.8 4.7 12 4.7 12 4.7s-5.8 0-7.6.5a2.9 2.9 0 0 0-2 2A30 30 0 0 0 2 12a30 30 0 0 0 .4 4.8 2.9 2.9 0 0 0 2 2c1.8.5 7.6.5 7.6.5s5.8 0 7.6-.5a2.9 2.9 0 0 0 2-2A30 30 0 0 0 22 12a30 30 0 0 0-.4-4.8Z"></path><path class="play-fill" d="m10 15.4 5-3.4-5-3.4v6.8Z"></path></svg>
      )}
      {social.key === "facebook" && (
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle class="fill" cx="12" cy="12" r="10"></circle><path class="play-fill" d="M13.4 20v-7h2.4l.4-2.8h-2.8V8.4c0-.8.2-1.4 1.4-1.4h1.5V4.5c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8v2.1H8V13h2.4v7h3Z"></path></svg>
      )}
      {social.key === "tiktok" && (
        <svg viewBox="0 0 24 24" aria-hidden="true"><path class="fill" d="M15.3 3c.3 2.1 1.5 3.3 3.7 3.5v3a8.3 8.3 0 0 1-3.7-.9v6.1a6.2 6.2 0 1 1-5.4-6.1v3.1a3.2 3.2 0 1 0 2.3 3V3h3.1Z"></path></svg>
      )}
      {social.key === "pinterest" && (
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M9.8 19c.7-2.4 1-3.6 1.4-5.4-.7-1.2.1-4.7 2.4-4.7 1.7 0 2.3 1.2 2.3 2.7 0 1.6-1 4-2.6 4-.9 0-1.5-.8-1.3-1.8l.7-2.8c.2-.8-.4-1.5-1.2-1.5-1 0-1.8 1-1.8 2.4 0 .9.3 1.5.3 1.5"></path></svg>
      )}
    </a>
  ) : (
    <span class="social-link--pending" title={`Add the ${social.label} URL in src/content/site.json`} aria-label={`${social.label} link to add`}>
      {social.key === "youtube" && (
        <svg viewBox="0 0 24 24" aria-hidden="true"><path class="fill" d="M21.6 7.2a2.9 2.9 0 0 0-2-2C17.8 4.7 12 4.7 12 4.7s-5.8 0-7.6.5a2.9 2.9 0 0 0-2 2A30 30 0 0 0 2 12a30 30 0 0 0 .4 4.8 2.9 2.9 0 0 0 2 2c1.8.5 7.6.5 7.6.5s5.8 0 7.6-.5a2.9 2.9 0 0 0 2-2A30 30 0 0 0 22 12a30 30 0 0 0-.4-4.8Z"></path><path class="play-fill" d="m10 15.4 5-3.4-5-3.4v6.8Z"></path></svg>
      )}
      {social.key === "pinterest" && (
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M9.8 19c.7-2.4 1-3.6 1.4-5.4-.7-1.2.1-4.7 2.4-4.7 1.7 0 2.3 1.2 2.3 2.7 0 1.6-1 4-2.6 4-.9 0-1.5-.8-1.3-1.8l.7-2.8c.2-.8-.4-1.5-1.2-1.5-1 0-1.8 1-1.8 2.4 0 .9.3 1.5.3 1.5"></path></svg>
      )}
    </span>
  ))}
</div>
