---
import SocialLinks from "./SocialLinks.astro";
import BrandMark from "./BrandMark.astro";
import Icon from "./Icon.astro";

interface NavItem { label: string; href: string; }
interface Social { label: string; key: string; href: string; }
interface Props { navigation: NavItem[]; socials: Social[]; }
const { navigation, socials } = Astro.props;
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="#top" aria-label="Tru Nobility home">
      <BrandMark inverse />
    </a>
    <nav aria-label="Primary navigation">
      <ul>
        {navigation.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
    <div class="header-actions">
      <SocialLinks socials={socials} compact />
      <a class="search-link" href="#essays" aria-label="Search the Tru Nobility archive">
        <Icon name="search" />
      </a>
    </div>
  </div>
</header>
