---
interface Props {
  product: { name: string; subtitle: string; image: string; imageAlt: string; href: string; };
}
const { product } = Astro.props;
---

<article class="product-card">
  <a href={product.href} target="_blank" rel="noreferrer" aria-label={`View ${product.name} in the Tru Nobility Etsy shop`}>
    <div class="product-image">
      <img src={product.image} alt={product.imageAlt} loading="lazy" />
    </div>
    <h3>{product.name}</h3>
    <p>{product.subtitle}</p>
  </a>
</article>
